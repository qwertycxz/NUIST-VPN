{
	"$schema": "https://schemastore.org/package",
	"bugs": "https://github.com/qwertycxz/NUIST-VPN/issues",
	"dependencies": {
		"esbuild": "^0.28.2",
		"esbuild-plugin-replace": "^2.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.9",
		"@types/chrome": "^0.2.7",
		"@types/node": "^26.4.0",
		"prettier": "^3.9.6",
		"typescript": "^7.0.2"
	},
	"funding": "https://ko-fi.com/qwertycxz",
	"license": "Apache-2.0",
	"name": "nuist-vpn",
	"prettier": {
		"arrowParens": "avoid",
		"jsxSingleQuote": true,
		"overrides": [
			{
				"files": "*.yml",
				"options": {
					"tabWidth": 2
				}
			}
		],
		"printWidth": 256,
		"proseWrap": "never",
		"quoteProps": "consistent",
		"semi": false,
		"singleQuote": true,
		"tabWidth": 4,
		"useTabs": true
	},
	"private": true,
	"scripts": {
		"build": "node esbuild/build.ts",
		"clean": "node esbuild/clean.ts",
		"dev": "node esbuild/dev.ts",
		"format": "prettier -w .",
		"format:check": "prettier -c .",
		"lint": "biome check",
		"lint:fix": "biome check --fix --unsafe",
		"type": "tsc"
	}
}
